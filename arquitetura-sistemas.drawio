                    </mxGeometry>
                </mxCell>
                <mxCell id="e-history-db" value="persists" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#999999;dashed=1;fontSize=10;" parent="1" source="history" target="history_db" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-history-identity" value="GET /users/{id} (cached)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d79b00;dashed=1;" parent="1" source="history" target="identity" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-identity-db" value="persists" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#999999;dashed=1;fontSize=10;" parent="1" source="identity" target="identity_db" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="Fluxo ponta a ponta" id="e2e-flow-page-01">
        <mxGraphModel dx="733" dy="416" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1720" math="0" shadow="0">
            <root>
                <mxCell id="e2e-0"/>
                <mxCell id="e2e-1" parent="e2e-0"/>
                <mxCell id="e2e-title" value="Hospital Appointment System &amp;mdash; End-to-End Walkthrough" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" parent="e2e-1" vertex="1">
                    <mxGeometry x="170" y="15" width="560" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="step0" value="0. Prerequisites&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;middot; Docker Desktop running (docker ps responds)&lt;/div&gt;&lt;div&gt;&amp;middot; Insomnia installed&lt;/div&gt;&lt;div&gt;&amp;middot; public.pem identical across the 4 services (identity signs the JWT, the others only validate)&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;" parent="e2e-1" vertex="1">
                    <mxGeometry x="170" y="90" width="560" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="steptests" value="0.5 Run the tests (unit + integration) and check coverage&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In each of the 4 repositories (identity-service, scheduling-service, notification-service, history-service):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;cd &amp;lt;service&amp;gt; &amp;amp;&amp;amp; ./mvnw test&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;middot; Runs unit tests (Mockito) and integration tests (@SpringBootTest + Testcontainers/MySQL). Without Docker running, integration tests are skipped (assumeTrue) instead of failing the build.&lt;/div&gt;&lt;div&gt;&amp;middot; JaCoCo is already wired into pom.xml (test phase) &amp;mdash; it generates the HTML coverage report at target/site/jacoco/index.html&lt;/div&gt;&lt;div&gt;&amp;middot; To see the percentage: open that index.html in a browser (one per service) &amp;mdash; shows % of lines/branches covered, per class&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;" parent="e2e-1" vertex="1">
                    <mxGeometry x="170" y="220" width="560" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="step1" value="1. Bring up the whole system (one command)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;cd hospital-system &amp;#160;(repo root)&lt;/div&gt;&lt;div&gt;docker compose up --build -d&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Starts the 4 apps + 4 MySQL + RabbitMQ + Kafka (shared) + kafka-ui + adminer, on one network, with no port conflicts&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;identity :8080 &amp;middot; scheduling :8085 &amp;middot; notification :8082 &amp;middot; history :8083&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;" parent="e2e-1" vertex="1">
                    <mxGeometry x="170" y="550" width="560" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="step2" value="2. Create users in identity and get a token&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Swagger: http://localhost:8080/swagger-ui.html&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;POST /auth/login (admin) &amp;rarr; POST /users (DOCTOR)&lt;/div&gt;&lt;div&gt;&amp;rarr; POST /users (PATIENT, with a real e-mail)&lt;/div&gt;&lt;div&gt;&amp;rarr; POST /auth/login (doctor) &amp;mdash; keep the accessToken&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Seeded admin: admin@hospital.local / admin12345&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;" parent="e2e-1" vertex="1">
                    <mxGeometry x="170" y="790" width="560" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="step3" value="3. Schedule an appointment&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;GraphiQL: http://localhost:8085/graphiql&lt;/div&gt;&lt;div&gt;Header: Authorization: Bearer &amp;lt;DOCTOR token&amp;gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;mutation scheduleAppointment(patientId, doctorId, scheduledAt)&lt;/div&gt;&lt;div&gt;&amp;rarr; writes to scheduling_db + publishes to RabbitMQ and Kafka&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;" parent="e2e-1" vertex="1">
                    <mxGeometry x="170" y="1050" width="560" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="step4a" value="4a. Check the (simulated) e-mail&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;RabbitMQ UI: http://localhost:15672&lt;/div&gt;&lt;div&gt;(guest / guest)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;reminder.queue should go back to zero (consumed)&lt;/div&gt;&lt;div&gt;&amp;rarr; docker logs notification-service&lt;/div&gt;&lt;div&gt;&amp;rarr; look for &amp;quot;Simulated e-mail sent to...&amp;quot;&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;" parent="e2e-1" vertex="1">
                    <mxGeometry x="170" y="1250" width="270" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="step4b" value="4b. Check the history&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Kafka UI: http://localhost:8084&lt;/div&gt;&lt;div&gt;topic appointment-events, consumer group &amp;quot;history&amp;quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;GraphiQL: http://localhost:8083/graphiql&lt;/div&gt;&lt;div&gt;query history(patientId)&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;" parent="e2e-1" vertex="1">
                    <mxGeometry x="460" y="1250" width="270" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="step5" value="5. Check the databases&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Adminer (one for all 4): http://localhost:8090&lt;/div&gt;&lt;div&gt;Server: mysql-identity / mysql-scheduling / mysql-notification / mysql-history&lt;/div&gt;&lt;div&gt;User/password: root / root&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;CLI: docker exec mysql-history mysql -uroot -proot history_db -e &amp;quot;SELECT * FROM appointment_history;&amp;quot;&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;" parent="e2e-1" vertex="1">
