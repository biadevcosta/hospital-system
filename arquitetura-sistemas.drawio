    <diagram name="Página-1" id="u4xIykFSWkHJ1O7X0Jwk">
        <mxGraphModel dx="2501" dy="335" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1250" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="client" value="Cliente (frontend / GraphiQL / Insomnia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="10" y="30" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="G3fp73hsxZ0u5p4biOgB-1" value="scheduling-service&lt;div&gt;porta da aplicação: 8081&lt;/div&gt;&lt;div&gt;GRAPHQL (mutations de scheduleAppointment e editAppointment)&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Persiste primeiro, publica depois (ScheduleAppointmentUseCase / EditAppointmentUseCase) —&lt;/div&gt;&lt;div&gt;&amp;nbsp; é o único ponto de saída de eventos de todo o sistema.&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="220" y="140" width="480" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="rabbitmq" value="RabbitMQ&lt;div&gt;exchange: appointment.reminders&lt;/div&gt;&lt;div&gt;routing key: appointment.reminder&lt;/div&gt;&lt;div&gt;fila: reminder.queue&lt;/div&gt;&lt;div&gt;msg: AppointmentReminderMessage (ids + scheduledAt)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="80" y="360" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="kafka" value="Kafka&lt;div&gt;tópico: appointment-events&lt;/div&gt;&lt;div&gt;key = patientId&lt;/div&gt;&lt;div&gt;msg: AppointmentEventMessage&lt;/div&gt;&lt;div&gt;(AppointmentCreated / AppointmentUpdated)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="470" y="360" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="G3fp73hsxZ0u5p4biOgB-4" value="&lt;div&gt;&amp;nbsp; Serviço: notification-service&lt;/div&gt;&lt;div&gt;&amp;nbsp; consumidor de mensagens (RabbitMQ)&lt;/div&gt;&lt;div&gt;&amp;nbsp; resolve nome/e-mail via identity e simula o&lt;/div&gt;&lt;div&gt;&amp;nbsp; envio do lembrete (log — Brevo fica pra depois)&lt;/div&gt;&lt;div&gt;&amp;nbsp; não guarda dados de negócio — só idempotência&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="80" y="530" width="270" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="G3fp73hsxZ0u5p4biOgB-2" value="&amp;nbsp; Serviço: history-service&lt;div&gt;&amp;nbsp; porta da aplicação: 8083&lt;/div&gt;&lt;div&gt;&amp;nbsp;GRAPHQL — expõe queries (history, futureAppointments), sem mutations.&lt;/div&gt;&lt;div&gt;&lt;div&gt;Consumidor:&amp;nbsp; via AppointmentEventListener (@KafkaListener, groupId = history), que monta o read model com idempotência (processed_events).&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="470" y="530" width="320" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="G3fp73hsxZ0u5p4biOgB-3" value="&lt;div&gt;&lt;div&gt;&amp;nbsp; Serviço: identity-service&lt;/div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp; porta da aplicação: 8080&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;REST + Swagger/OpenAPI (POST /auth/login, POST /users, GET /users/{id}).&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="255" y="770" width="390" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="Obs.: scheduling, notification e history validam o JWT RS256 localmente com a chave pública compartilhada (public.pem) — não é uma chamada de rede ao identity." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontStyle=2;align=left;spacingLeft=6;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="255" y="970" width="390" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e-client-scheduling" value="GraphQL (JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="client" target="G3fp73hsxZ0u5p4biOgB-1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-client-identity" value="REST (login / registro)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="client" target="G3fp73hsxZ0u5p4biOgB-3" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="150" y="340"/>
