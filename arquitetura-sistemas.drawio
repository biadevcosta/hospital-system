                    </mxGeometry>
                </mxCell>
                <mxCell id="e-scheduling-rabbit" value="publica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;" parent="1" source="G3fp73hsxZ0u5p4biOgB-1" target="rabbitmq" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
