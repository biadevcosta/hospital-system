                    </mxGeometry>
                </mxCell>
                <mxCell id="e-scheduling-db" value="persists" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#999999;dashed=1;fontSize=10;" parent="1" source="scheduling" target="scheduling_db" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-scheduling-rabbit" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" parent="1" source="scheduling" target="rabbitmq" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-scheduling-kafka" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" parent="1" source="scheduling" target="kafka" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-rabbit-notification" value="consumes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" parent="1" source="rabbitmq" target="notification" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-kafka-history" value="consumes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" parent="1" source="kafka" target="history" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-notification-db" value="persists" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#999999;dashed=1;fontSize=10;" parent="1" source="notification" target="notification_db" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-notification-brevo" value="simulates send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d79b00;dashed=1;" parent="1" source="notification" target="brevo" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e-notification-identity" value="GET /users/{id} (cached)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#d79b00;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="notification" target="identity" edge="1">
