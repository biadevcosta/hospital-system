    <diagram name="Página-1" id="u4xIykFSWkHJ1O7X0Jwk">
        <mxGraphModel dx="2133" dy="416" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1450" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Hospital Appointment System &amp;mdash; Architecture Overview" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="20" y="10" width="1360" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="client" value="&lt;b&gt;Client&lt;/b&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;frontend &amp;middot; GraphiQL &amp;middot; Insomnia&lt;/div&gt;" style="rounded=1;arcSize=12;shadow=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="470" y="70" width="310" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="scheduling" value="&lt;b&gt;scheduling-service&lt;/b&gt; &amp;mdash; port 8081&lt;div style=&quot;margin-top:6px;&quot;&gt;GraphQL mutations: &lt;b&gt;scheduleAppointment&lt;/b&gt;, &lt;b&gt;editAppointment&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;Persists first, publishes after (validate &amp;rarr; persist &amp;rarr; publish).&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;The single source of truth for appointments, and the only producer of events in the system.&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="350" y="190" width="550" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="scheduling_db" value="&lt;b&gt;scheduling_db&lt;/b&gt; (3306)&lt;div style=&quot;margin-top:8px;&quot;&gt;Table: appointments&lt;/div&gt;&lt;div&gt;(id, patient_id, doctor_id,&lt;/div&gt;&lt;div&gt;scheduled_at, status, created_at)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="940" y="210" width="220" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="rabbitmq" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;exchange: appointment.reminders&lt;/div&gt;&lt;div&gt;routing key: appointment.reminder&lt;/div&gt;&lt;div&gt;queue: reminder.queue (+ reminder.dlq)&lt;/div&gt;&lt;div&gt;msg: AppointmentReminderMessage&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="140" y="420" width="320" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="kafka" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;topic: appointment-events&lt;/div&gt;&lt;div&gt;key = patientId (ordering per patient)&lt;/div&gt;&lt;div&gt;msg: AppointmentCreated / AppointmentUpdated&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="580" y="420" width="320" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="notification" value="&lt;b&gt;notification-service&lt;/b&gt; &amp;mdash; port 8082&lt;div style=&quot;margin-top:6px;&quot;&gt;@RabbitListener consumer &amp;mdash; no inbound API&lt;/div&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;resolves name/e-mail via identity (cached)&lt;/div&gt;&lt;div&gt;sends the reminder (log &amp;mdash; provider is pluggable)&lt;/div&gt;&lt;div&gt;idempotent &amp;mdash; stores no business data&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="100" y="620" width="320" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="notification_db" value="&lt;b&gt;notification_db&lt;/b&gt; (3307)&lt;div style=&quot;margin-top:8px;&quot;&gt;Table: processed_reminders&lt;/div&gt;&lt;div&gt;(appointment_id, processed_at)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="100" y="820" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="brevo" value="&lt;b&gt;LoggingEmailSender&lt;/b&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;logs &amp;quot;Simulated e-mail sent...&amp;quot;&lt;/div&gt;&lt;div&gt;instead of calling a real provider&lt;/div&gt;&lt;div&gt;(swap the EmailSender port later)&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="340" y="820" width="180" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="history" value="&lt;b&gt;history-service&lt;/b&gt; &amp;mdash; port 8083&lt;div style=&quot;margin-top:6px;&quot;&gt;GraphQL queries: &lt;b&gt;history&lt;/b&gt;, &lt;b&gt;futureAppointments&lt;/b&gt; (no mutations)&lt;/div&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;@KafkaListener (groupId=history) builds a read model with idempotency (processed_events)&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="580" y="620" width="380" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="history_db" value="&lt;b&gt;history_db&lt;/b&gt; (3308)&lt;div style=&quot;margin-top:8px;&quot;&gt;Table: appointment_history&lt;/div&gt;&lt;div&gt;(appointment_id, patient_id,&lt;/div&gt;&lt;div&gt;doctor_id, scheduled_at, status)&lt;/div&gt;&lt;div style=&quot;margin-top:8px;&quot;&gt;Table: processed_events&lt;/div&gt;&lt;div&gt;(event_id, processed_at)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="990" y="620" width="240" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="identity" value="&lt;b&gt;identity-service&lt;/b&gt; &amp;mdash; port 8080&lt;div style=&quot;margin-top:6px;&quot;&gt;REST + Swagger/OpenAPI&lt;/div&gt;&lt;div style=&quot;margin-top:4px;&quot;&gt;&lt;b&gt;POST /auth/login&lt;/b&gt; &amp;middot; &lt;b&gt;POST /users&lt;/b&gt; &amp;middot; &lt;b&gt;GET /users/{id}&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:10px;&quot;&gt;Signs the JWT (RS256) with the private key. The only service that can issue a token.&lt;/div&gt;" style="rounded=1;arcSize=8;shadow=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="350" y="1020" width="550" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="identity_db" value="&lt;b&gt;identity_db&lt;/b&gt; (3309)&lt;div style=&quot;margin-top:8px;&quot;&gt;Table: users&lt;/div&gt;&lt;div&gt;(email, password_hash, role,&lt;/div&gt;&lt;div&gt;full_name, crm, specialty...)&lt;/div&gt;&lt;div style=&quot;margin-top:8px;&quot;&gt;Table: refresh_tokens&lt;/div&gt;&lt;div&gt;(token_hash, user_id,&lt;/div&gt;&lt;div&gt;expires_at, revoked)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;shadow=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1020" width="220" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;div style=&quot;margin-top:8px;&quot;&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&amp;#9632;&lt;/font&gt;&amp;nbsp;Service &amp;mdash; GraphQL &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#d79b00&quot;&gt;&amp;#9632;&lt;/font&gt;&amp;nbsp;Service &amp;mdash; REST / consumer &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#82b366&quot;&gt;&amp;#9632;&lt;/font&gt;&amp;nbsp;Message broker &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#b85450&quot;&gt;&amp;#9632;&lt;/font&gt;&amp;nbsp;Database &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#666666&quot;&gt;&amp;#9632;&lt;/font&gt;&amp;nbsp;Client / external&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-style:italic;color:#666666;&quot;&gt;scheduling, notification and history validate the RS256 JWT locally with the shared public key (public.pem) &amp;mdash; never a network call to identity.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;" parent="1" vertex="1">
